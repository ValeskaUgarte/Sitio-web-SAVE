# Puerto donde corre el servidor. Render/Railway lo definen automáticamente.
PORT=3000

# Cambia este valor por uno propio y secreto antes de usar en producción.
# Se usa para firmar la cookie de sesión del panel de administración.
SESSION_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio

# Opcional: si el sitio y el panel se sirven desde dominios distintos,
# indica aquí el origen permitido (ej: https://tusitio.cl). Si se sirven
# desde el mismo dominio (recomendado, es como está configurado por
# defecto), puedes dejar esta línea comentada.
# CORS_ORIGIN=https://tusitio.cl

NODE_ENV=development
